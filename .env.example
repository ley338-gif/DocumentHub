# -----------------------------------------------------------------------------
# Document Hub — docker-compose environment
#
# Copy this file to `.env` (same directory as docker-compose.yml) and adjust
# before running `docker compose up -d --build`. Docker Compose loads `.env`
# automatically. `.env` itself is git-ignored — never commit real secrets.
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
POSTGRES_USER=document_hub
POSTGRES_PASSWORD=document_hub
POSTGRES_DB=document_hub
# Must stay consistent with the three values above — "postgres" is the
# compose service name, resolved on the internal Docker network only.
DATABASE_URL=postgresql://document_hub:document_hub@postgres:5432/document_hub

# --- Auth ----------------------------------------------------------------------
# UNSAFE EXAMPLE VALUE. Generate a real secret before any deployment anyone
# other than you can reach, e.g.: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_REAL_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h

# INVITE_ONLY (default, recommended for any real tenant) or SELF_SERVICE
# (open self-registration — local trial/demo only).
REGISTRATION_MODE=INVITE_ONLY

# --- Public origins ------------------------------------------------------------
# The browser-reachable origin of the WEB service. QR codes encode this URL
# directly — it must be reachable by end customers, never the internal
# Docker service names ("web"/"api") or an internal-only address.
PUBLIC_BASE_URL=http://localhost:8080
# The browser-reachable origin of the API service. Vite embeds VITE_* at
# BUILD time, not container start — rebuild the web image
# (`docker compose build web`) whenever this changes.
VITE_API_BASE_URL=http://localhost:3000

# --- Storage ---------------------------------------------------------------------
# "local" (default): files live in a persistent named Docker volume, no
# extra service required — see docs/deployment.md for the AGPL/MinIO
# rationale. "s3": talks to an S3-compatible store configured below; for
# local testing, start the optional MinIO service with
# `docker compose --profile s3 up -d`, or point at a real provider (AWS S3,
# Hetzner Object Storage, ...) for an actual deployment.
STORAGE_DRIVER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=document-hub
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true

# --- Host ports ------------------------------------------------------------------
API_PORT=3000
WEB_PORT=8080
POSTGRES_PORT=5432

# --- Runtime / security ------------------------------------------------------------
# "production" enables fail-fast startup validation: a strong JWT_SECRET, an
# HTTPS+non-localhost PUBLIC_BASE_URL, complete storage config, etc — see
# docs/security.md. Leave this as "development" for a bare local trial on
# localhost; only set "production" once this is genuinely reachable behind
# a real HTTPS reverse proxy with a real domain in PUBLIC_BASE_URL (see
# docker-compose.production.yml).
NODE_ENV=development
# Number of reverse-proxy hops in front of the API to trust for
# X-Forwarded-* headers (client IP, protocol). 0 = none — correct for this
# file's direct host-port-mapping setup. Set to 1 once you put a reverse
# proxy in front (see docker-compose.production.yml / docs/deployment.md).
TRUST_PROXY=0
# Extra allowed CORS origins beyond PUBLIC_BASE_URL's own origin,
# comma-separated. Usually unnecessary — PUBLIC_BASE_URL already covers the
# real frontend origin.
CORS_ALLOWED_ORIGINS=
