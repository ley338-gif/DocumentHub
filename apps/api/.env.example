DATABASE_URL=postgresql://document_hub:document_hub@localhost:5432/document_hub
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=document-hub
STORAGE_S3_ACCESS_KEY=document_hub
STORAGE_S3_SECRET_KEY=document_hub_secret
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true

# Must be the deployed *frontend's* public origin (the SPA serves /p/:stableId
# and /u/:stableId itself) — never this API's own origin. In local dev that's
# the Vite dev server, not this server's PORT above.
PUBLIC_BASE_URL=http://localhost:5173

# INVITE_ONLY (default, production-like): the only way to create a User is
# by accepting an Invitation — open /auth/register and self-service
# POST /organizations are both disabled for non-platform-admins.
# SELF_SERVICE: restores the original open register -> create-organization
# flow, for local development convenience only.
REGISTRATION_MODE=INVITE_ONLY

# The very first platform administrator is never created over HTTP — run:
#   BOOTSTRAP_ADMIN_EMAIL=you@example.com BOOTSTRAP_ADMIN_PASSWORD=... npm run bootstrap:platform-admin
# from apps/api. Idempotent; safe to re-run. These are consumed only by
# that one-off script, not read by the running server, so they are not
# meant to live in this file long-term.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
