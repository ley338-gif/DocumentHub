DATABASE_URL=postgresql://document_hub:document_hub@localhost:5432/document_hub_test
JWT_SECRET=test-secret
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage-test
PUBLIC_BASE_URL=http://localhost:5173
# Existing e2e specs assume open self-service registration (registerAndLogin
# helper posts straight to /api/auth/register) — keep that working exactly
# as before. The new platform-administration e2e spec exercises
# INVITE_ONLY behavior explicitly by toggling process.env.REGISTRATION_MODE
# for just the assertions that need it.
REGISTRATION_MODE=SELF_SERVICE
# The e2e suite drives every simulated "user" from a single test-client IP,
# so a single spec file's dozens of register+login calls can trip the
# production-realistic 30/min-per-IP auth throttle in seconds — a pattern
# no real single client produces. Raise the ceiling for tests only; the
# production default (unset here) stays at 30. See AuthModule for details.
AUTH_THROTTLE_LIMIT=1000
