# Existing e2e specs assume open self-service registration (registerAndLogin
# helper posts straight to /api/auth/register) — keep that working exactly
# as before. The new platform-administration e2e spec exercises
# INVITE_ONLY behavior explicitly by toggling process.env.REGISTRATION_MODE
# for just the assertions that need it.
REGISTRATION_MODE=SELF_SERVICE
